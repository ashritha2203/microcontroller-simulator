package logging;

import shared.IPCMessage;

import java.io.FileInputStream;
import java.io.ObjectInputStream;
import java.io.PrintWriter;
import java.io.FileWriter;
import java.util.concurrent.ArrayBlockingQueue;
import java.util.concurrent.BlockingQueue;

public class LoggingProcess {

    // POSIX FIFO path
    private static final String FIFO_PATH = "/tmp/logging_fifo";

    private final BlockingQueue<String> logFCFSQueue =
            new ArrayBlockingQueue<>(200);

    public static void main(String[] args) {
        new LoggingProcess().start();
    }

    public void start() {

        System.out.println("[LOGGING PROCESS] Starting Async Log Daemon...");

        // Thread 1: Async FCFS Writer Thread
        new Thread(this::fileWriterWorker).start();

        // Thread 2: POSIX FIFO Listener Thread
        try {

            System.out.println(
                "[LOGGING PROCESS] Waiting for log streams on FIFO: "
                + FIFO_PATH
            );

            /*
             * Read from POSIX named pipe (FIFO)
             */
            try (
                FileInputStream fis = new FileInputStream(FIFO_PATH);
                ObjectInputStream in = new ObjectInputStream(fis)
            ) {

                while (true) {

                    IPCMessage msg =
                            (IPCMessage) in.readObject();

                    if (msg.getLogText() != null) {

                        // FCFS ordering
                        logFCFSQueue.put(msg.getLogText());
                    }
                }

            }

        } catch (Exception e) {

            System.err.println(
                "[LOGGER ERROR] FIFO connection lost: "
                + e.getMessage()
            );
        }
    }

    private void fileWriterWorker() {

        // Set true to display DEBUG logs in terminal
        boolean showDebugInConsole = false;

        try (
            PrintWriter writer =
                new PrintWriter(
                    new FileWriter("simulation.log", true)
                )
        ) {

            while (true) {

                // FIFO queue → FCFS
                String logText = logFCFSQueue.take();

                String formattedLog =
                        String.format(
                            "[%tF %<tT] %s",
                            System.currentTimeMillis(),
                            logText
                        );

                // Save every log to file
                writer.println(formattedLog);
                writer.flush();

                // Display non-debug logs in terminal
                if (showDebugInConsole ||
                    !logText.contains("[DEBUG]")) {

                    System.out.println(
                        "[LOG] " + formattedLog
                    );
                }
            }

        } catch (Exception e) {

            System.err.println(
                "[LOGGER WRITE ERROR] "
                + e.getMessage()
            );
        }
    }
}
